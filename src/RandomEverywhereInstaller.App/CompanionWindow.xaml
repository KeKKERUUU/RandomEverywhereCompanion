<Window x:Class="RandomEverywhereInstaller.App.CompanionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RandomEverywhereInstaller.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Random &amp; Everywhere Companion" Icon="Assets/App/app.ico"
        Width="1180" Height="760" MinWidth="1060" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Brush.Window}" Foreground="{StaticResource Brush.Text}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="6" CornerRadius="3" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#3D4B56" BorderThickness="1">
    <Grid UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="ShellStatusRow" Height="42" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource Cockpit.Panel}" BorderBrush="#43515D" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="128" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="184" /><ColumnDefinition Width="142" /><ColumnDefinition Width="136" />
                </Grid.ColumnDefinitions>
                <Border Margin="10" BorderBrush="#50606A" BorderThickness="1" Background="#080D11" ClipToBounds="True">
                    <Image Source="Assets/Header/helicopter-rescue.jpeg" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="Random &amp; Everywhere" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Companion" Foreground="#B0C0CA" FontSize="17" Margin="0,3,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="2" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"
                          VerticalAlignment="Center" Margin="0,0,16,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <ComboBox.ItemTemplate><DataTemplate>
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Note}">
                            <Image Source="{Binding FlagImage}" Width="25" Height="20" Stretch="UniformToFill" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding NativeName}" FontSize="16" />
                        </StackPanel>
                    </DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="SettingsButton" Grid.Column="3" ContentTemplate="{StaticResource ActionLabel}" Content="{Binding L[C.Nav.Settings]}" Command="{Binding OpenOptionsCommand}"
                        Style="{StaticResource GhostButton}"
                        Visibility="{Binding HasEntered, Converter={StaticResource BoolVisibility}}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource ChromeButton}" Click="Minimize" ToolTip="{Binding L[Window.Minimize]}" AutomationProperties.Name="{Binding L[Window.Minimize]}"><Image Source="Assets/WindowControls/minimize.png" Width="22" /></Button>
                    <Button Style="{StaticResource ChromeButton}" Click="Maximize" ToolTip="{Binding L[Window.MaximizeRestore]}" AutomationProperties.Name="{Binding L[Window.MaximizeRestore]}"><Image Source="Assets/WindowControls/maximize.png" Width="22" /></Button>
                    <Button Style="{StaticResource ChromeButton}" Click="CloseWindow" ToolTip="{Binding L[Action.Exit]}" AutomationProperties.Name="{Binding L[Action.Exit]}"><Image Source="Assets/WindowControls/close.png" Width="22" /></Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="CompanionBody" Grid.Row="1" Margin="18,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,16" Visibility="{Binding HasMainPage, Converter={StaticResource BoolVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Button ContentTemplate="{StaticResource ActionLabel}" Content="{Binding L[C.New.Mission]}" Command="{Binding NavigateCommand}" CommandParameter="Mission" Width="100" Margin="0,0,8,0">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButton}"><Style.Triggers>
                            <DataTrigger Binding="{Binding IsMissionPage}" Value="True"><Setter Property="BorderBrush" Value="#49ACE0"/><Setter Property="Background" Value="#163F58"/></DataTrigger>
                        </Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button ContentTemplate="{StaticResource ActionLabel}" Content="{Binding L[C.New.Sound]}" Command="{Binding NavigateCommand}" CommandParameter="Audio" Width="100">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButton}"><Style.Triggers>
                            <DataTrigger Binding="{Binding IsSoundArea}" Value="True"><Setter Property="BorderBrush" Value="#49ACE0"/><Setter Property="Background" Value="#163F58"/></DataTrigger>
                        </Style.Triggers></Style></Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Section}" Value="Loading"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
<TextBlock Text="{Binding L[C.Status.Working]}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
</Grid>
<local:CompanionOptionsView x:Name="InlineOptions" Visibility="{Binding IsOptionsPage, Converter={StaticResource BoolVisibility}}"/>
            <Grid>
                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding Section}" Value="Disclaimer"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></Grid.Style>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding L[C.Nav.Disclaimer]}" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,22" />
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="30">
                    <TextBlock Text="{Binding L[C.Disclaimer.Body]}" TextWrapping="Wrap" FontSize="19" LineHeight="29" VerticalAlignment="Center" MaxWidth="1060" />
                </Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button ContentTemplate="{StaticResource ActionLabel}" Content="{Binding L[Action.Exit]}" Click="CloseWindow" Style="{StaticResource GhostButton}" Margin="0,0,16,0" />
                    <Button ContentTemplate="{StaticResource ActionLabel}" Content="{Binding L[Action.Continue]}" Command="{Binding ContinueCommand}" Style="{StaticResource SuccessButton}" MinWidth="180" />
                </StackPanel>
            </Grid>

            <Grid MaxWidth="940">
                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding Section}" Value="Community"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></Grid.Style>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding L[C.Flow.CommunityTitle]}" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Text="{Binding L[C.Flow.CommunityHint]}" Style="{StaticResource QuietText}" Margin="0,12,0,24" />
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="30">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Visibility="{Binding HasDetectedCommunities, Converter={StaticResource BoolVisibility}}">
                            <ComboBox ItemsSource="{Binding DetectedCommunities}" SelectedItem="{Binding DetectedCommunity}">
                                <ComboBox.ItemTemplate><DataTemplate><StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Path}" FontSize="14" Foreground="#A6BDCC" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                </StackPanel></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button ContentTemplate="{StaticResource ActionLabel}" Content="{Binding L[C.Flow.UseCommunity]}" Command="{Binding UseDetectedCommunityCommand}"
                                    Style="{StaticResource SuccessButton}" HorizontalAlignment="Right" Margin="0,20,0,24" />
                        </StackPanel>
                        <TextBlock Text="{Binding L[C.Flow.ManualCommunity]}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding CommunityPath}" TextWrapping="Wrap" Margin="0,8,0,8"
                                   Visibility="{Binding HasCommunity, Converter={StaticResource BoolVisibility}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,20">
                            <RadioButton Content="MSFS 2020" IsChecked="{Binding IsMsfs2020}" Margin="0,0,32,0" />
                            <RadioButton Content="MSFS 2024" IsChecked="{Binding IsMsfs2024}" />
                        </StackPanel>
                        <Button ContentTemplate="{StaticResource ActionLabel}" Content="{Binding L[Action.Browse]}" Command="{Binding BrowseCommunityCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" MinWidth="180" />
                    </StackPanel>
                </Border>
                <Button Grid.Row="3" Content="{Binding L[Action.Back]}" Command="{Binding CancelCommunityCommand}"
                        Visibility="{Binding CanCancelCommunity, Converter={StaticResource BoolVisibility}}"
                        Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,16,0,0" />
            </Grid>

                <Grid Visibility="{Binding IsMissionPage, Converter={StaticResource BoolVisibility}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <Border Style="{StaticResource InstrumentWell}" Padding="16,12" Margin="0,0,10,0"><StackPanel>
                            <TextBlock Text="{Binding L[C.Cockpit.Simulator]}" Style="{StaticResource PanelLabel}"/>
                            <TextBlock Text="{Binding SimulatorName}" FontSize="18" Margin="0,6,0,0"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource InstrumentWell}" Padding="16,12" Margin="0,0,10,0"><StackPanel>
                            <TextBlock Text="{Binding L[C.Cockpit.Mission]}" Style="{StaticResource PanelLabel}"/>
                            <TextBlock Text="{Binding MissionVersion}" Foreground="{Binding MissionVersionColor}" FontSize="18" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding MissionVersion}"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource InstrumentWell}" Padding="16,12"><StackPanel>
                            <TextBlock Text="{Binding L[C.Path.Community]}" Style="{StaticResource PanelLabel}"/>
                            <TextBlock Text="{Binding CommunitySummary}" FontSize="18" Margin="0,6,0,0" ToolTip="{Binding CommunityPath}"/>
                        </StackPanel></Border>
                    </UniformGrid>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
                        <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource Card}" Padding="14"><Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="Random &amp; Everywhere" FontSize="20" FontWeight="SemiBold" ToolTip="{Binding Prerequisites}"/>
                                <TextBlock Grid.Row="1" Text="{Binding L[C.New.MissionHint]}" Style="{StaticResource QuietText}" Margin="0,8,0,8"/>
                                <UniformGrid Columns="3" HorizontalAlignment="Stretch" Grid.Row="2">
                                    <Button ContentTemplate="{StaticResource ActionLabel}" Margin="4,3" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Content="{Binding L[C.MissionUpdate.Title]}" Command="{Binding UpdateMissionCommand}" Style="{StaticResource PrimaryButton}"/>
                                    <Button ContentTemplate="{StaticResource ActionLabel}" Margin="4,3" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Content="{Binding L[C.New.Verify]}" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"/>
                                    <Button ContentTemplate="{StaticResource ActionLabel}" Margin="4,3" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Content="{Binding L[C.Nav.Tools]}" Command="{Binding OpenMaintenanceCommand}" Style="{StaticResource SecondaryButton}"/>
                                </UniformGrid>
                            </Grid></Border>
                            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0"><Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding L[C.New.H145Title]}" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding H145ActionHint}" Style="{StaticResource QuietText}" FontSize="13" Margin="0,5,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" ContentTemplate="{StaticResource ActionLabel}" Content="{Binding L[C.New.H145Action]}" Command="{Binding UpdateH145Command}" Style="{StaticResource SecondaryButton}"/>
                            </Grid></Border>
                        </Grid>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20"><Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0"><TextBlock Text="{Binding L[C.New.Addons]}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding InventorySummary}" Style="{StaticResource QuietText}" FontSize="14" Margin="0,6,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" ContentTemplate="{StaticResource ActionLabel}" Content="{Binding L[C.Install.Full]}" Command="{Binding InstallCommand}" Style="{StaticResource SuccessButton}"/>
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding InstalledPackages}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                                <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="16" Foreground="#E2E9ED" Margin="0,0,16,0"/>
                                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding StateText}" FontSize="14" Foreground="{Binding StatusColor}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding RequirementText}" FontSize="12" Foreground="#A8B6C0" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <UniformGrid Columns="2" HorizontalAlignment="Stretch" Grid.Row="2" Margin="0,12,0,0">
                                <Button ContentTemplate="{StaticResource ActionLabel}" Margin="4,3" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Content="{Binding L[C.New.OpenFolder]}" Command="{Binding OpenCommunityCommand}" Style="{StaticResource GhostButton}"/>
                                <Button ContentTemplate="{StaticResource ActionLabel}" Margin="4,3" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Content="{Binding L[C.Flow.ChangeCommunity]}" Command="{Binding NavigateCommand}" CommandParameter="Community" Style="{StaticResource GhostButton}"/>
                            </UniformGrid>
                        </Grid></Border>
                    </Grid>
                </Grid>
                <Grid Visibility="{Binding IsSoundPage, Converter={StaticResource BoolVisibility}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="{Binding L[C.New.SourceHint]}" Style="{StaticResource QuietText}" Margin="0,0,0,12"/>
                        <UniformGrid Grid.Row="1" Columns="2"><Button AutomationProperties.Name="{Binding L[C.Flow.Recorded]}" Command="{Binding NavigateCommand}" CommandParameter="Recorded" IsEnabled="{Binding CanEditAudio}" HorizontalContentAlignment="Stretch" Margin="0,0,6,10">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Style.Triggers>
                                <DataTrigger Binding="{Binding IsRecordedMode}" Value="True"><Setter Property="BorderBrush" Value="#49ACE0"/><Setter Property="Background" Value="#163F58"/></DataTrigger>
                            </Style.Triggers></Style></Button.Style>
                            <StackPanel><TextBlock Text="{Binding L[C.Flow.Recorded]}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding RecordedPackSummary}" FontSize="14" Foreground="#B3C5D0" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{Binding L[C.Flow.Synthetic]}" Command="{Binding NavigateCommand}" CommandParameter="Synthetic" IsEnabled="{Binding CanEditAudio}" HorizontalContentAlignment="Stretch" Margin="6,0,0,10">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Style.Triggers>
                                <DataTrigger Binding="{Binding IsSyntheticMode}" Value="True"><Setter Property="BorderBrush" Value="#49ACE0"/><Setter Property="Background" Value="#163F58"/></DataTrigger>
                            </Style.Triggers></Style></Button.Style>
                            <StackPanel><TextBlock Text="{Binding L[C.Flow.Synthetic]}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SyntheticPackSummary}" FontSize="14" Foreground="#B3C5D0" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Button>
                        </UniformGrid>
                        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="18"><Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel IsEnabled="{Binding CanEditAudio}">
                                <ComboBox ItemsSource="{Binding RecordedPacks}" SelectedItem="{Binding RecordedPack}" DisplayMemberPath="Name" Visibility="{Binding IsRecordedMode, Converter={StaticResource BoolVisibility}}" FontSize="16" AutomationProperties.Name="{Binding L[C.Audio.Pack]}"/>
                                <DockPanel Margin="0,6,0,0" Visibility="{Binding IsRecordedMode, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding L[C.Recorded.Search]}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="14"/><TextBox Text="{Binding RecordedSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding L[C.Recorded.Search]}" Padding="8,4"/></DockPanel>
                                <Grid Visibility="{Binding IsSyntheticMode, Converter={StaticResource BoolVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0"><TextBlock Text="{Binding L[C.Voice.Language]}" FontSize="14" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding VoiceLanguages}" SelectedItem="{Binding VoiceLanguage}" FontSize="16" AutomationProperties.Name="{Binding L[C.Voice.Language]}"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding L[C.Voice.TextPack]}" FontSize="14" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding TextPacks}" SelectedItem="{Binding TextPack}" DisplayMemberPath="Name" FontSize="16" AutomationProperties.Name="{Binding L[C.Voice.TextPack]}"/></StackPanel>
                                </Grid>
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,10,0,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="{Binding AudioAvailabilityHint}" Foreground="#E2BD7D" FontSize="14">
                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource QuietText}"><Style.Triggers><DataTrigger Binding="{Binding AudioAvailabilityHint}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <ListBox Grid.Row="1" ItemsSource="{Binding FilteredRecordedSounds}" SelectedItem="{Binding RecordedSound}" Background="Transparent" BorderThickness="0"
                                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True" Visibility="{Binding IsRecordedMode, Converter={StaticResource BoolVisibility}}">
                                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,5">
                                        <TextBlock Text="{Binding Variable}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Summary}" FontSize="14" Foreground="{StaticResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                                    </StackPanel></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <ListBox Grid.Row="1" ItemsSource="{Binding Actors}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsSyntheticMode, Converter={StaticResource BoolVisibility}}">
                                    <ListBox.ItemTemplate><DataTemplate><Grid Margin="4,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="14"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Voice.Name}" FontSize="14" Foreground="{StaticResource Brush.TextMuted}" TextTrimming="CharacterEllipsis"/>
                                    </Grid></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                            <UniformGrid HorizontalAlignment="Stretch" Grid.Row="2">
                                <UniformGrid.Style><Style TargetType="UniformGrid"><Setter Property="Columns" Value="2"/><Style.Triggers><DataTrigger Binding="{Binding IsRecordedMode}" Value="False"><Setter Property="Columns" Value="1"/></DataTrigger></Style.Triggers></Style></UniformGrid.Style>
                                <Button ContentTemplate="{StaticResource ActionLabel}" Margin="4,3" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Content="{Binding L[C.Recorded.Preview]}" Command="{Binding PreviewRecordedSoundCommand}" Style="{StaticResource PrimaryButton}" Visibility="{Binding IsRecordedMode, Converter={StaticResource BoolVisibility}}"/>
                                <Button ContentTemplate="{StaticResource ActionLabel}" Margin="4,3" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Content="{Binding L[C.New.ManageVoices]}" Command="{Binding OpenAudioOptionsCommand}" Style="{StaticResource PrimaryButton}"/>
                            </UniformGrid>
                        </Grid></Border>
                    </Grid>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24"><Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="{Binding L[C.Audio.Output]}" Style="{StaticResource Caption}"/>
                        <Grid Grid.Row="1" IsEnabled="{Binding CanEditAudio}">
                            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding RecordedDevice}" DisplayMemberPath="Name" Visibility="{Binding IsRecordedMode, Converter={StaticResource BoolVisibility}}" FontSize="17"/>
                            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding HeadsetDevice}" DisplayMemberPath="Name" Visibility="{Binding IsSyntheticMode, Converter={StaticResource BoolVisibility}}" FontSize="17"/>
                        </Grid>
                        <StackPanel Grid.Row="2" Margin="0,28,0,0">
                            <TextBlock Text="{Binding AudioEditsStatus}" TextWrapping="Wrap" FontSize="14" Foreground="#E2BD7D" Margin="0,0,0,8" Visibility="{Binding HasPendingAudioEdits, Converter={StaticResource BoolVisibility}}"/>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding RecordedVolume, StringFormat={}{0}%}" Visibility="{Binding IsRecordedMode, Converter={StaticResource BoolVisibility}}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SyntheticVolume, StringFormat={}{0}%}" Visibility="{Binding IsSyntheticMode, Converter={StaticResource BoolVisibility}}"/>
                                <TextBlock Text="{Binding L[C.Audio.Volume]}" Style="{StaticResource PanelLabel}"/>
                            </DockPanel>
                            <Slider AutomationProperties.Name="{Binding L[C.Audio.Volume]}" Minimum="0" Maximum="100" Value="{Binding RecordedVolume, Mode=TwoWay}" IsEnabled="{Binding CanAdjustRecordedVolume}" Visibility="{Binding IsRecordedMode, Converter={StaticResource BoolVisibility}}" Margin="0,18,0,0"/>
                            <Slider AutomationProperties.Name="{Binding L[C.Audio.Volume]}" Minimum="0" Maximum="100" Value="{Binding SyntheticVolume, Mode=TwoWay}" IsEnabled="{Binding CanEditAudio}" Visibility="{Binding IsSyntheticMode, Converter={StaticResource BoolVisibility}}" Margin="0,18,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" VerticalAlignment="Center" Margin="0,18">
                            <StackPanel Visibility="{Binding IsRecordedMode, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="{Binding AudioEditsHint}" FontSize="14" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                <TextBlock Text="{Binding L[C.Recorded.LastPlayed]}" Style="{StaticResource PanelLabel}"/>
                                <TextBlock Text="{Binding RecordedLastPlayed}" FontSize="16" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsSyntheticMode, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="{Binding L[C.New.Engine]}" Style="{StaticResource PanelLabel}"/>
                                <TextBlock Text="{Binding EngineVersion}" FontSize="18" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding ActiveMissionId}" FontSize="14" Foreground="#B3C5D0" Margin="0,6,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <UniformGrid Columns="2" HorizontalAlignment="Stretch" Grid.Row="4">
                            <Button ContentTemplate="{StaticResource ActionLabel}" Margin="4,3" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Content="{Binding L[C.Audio.Test]}" Command="{Binding TestCommand}" Style="{StaticResource PrimaryButton}"/>
                            <Button ContentTemplate="{StaticResource ActionLabel}" Margin="4,3" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Content="{Binding RecordedMuteLabel}" Command="{Binding ToggleRecordedMuteCommand}" Style="{StaticResource SecondaryButton}" Visibility="{Binding IsRecordedMode, Converter={StaticResource BoolVisibility}}"/>
                        </UniformGrid>
                    </Grid></Border>
                </Grid>
            </Grid>
      </Grid>
        <!-- Reserve shell space for the simulator action independently of page content height. -->
        <ContentControl x:Name="InstallerHost" Grid.Row="1" Margin="18,12" Visibility="Collapsed"/>
        <Border x:Name="SimulatorConnectionBar" Grid.Row="2" Padding="14,9" Margin="18,0,18,10">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasMainPage}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="{Binding SelectedPackName}" FontSize="17" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedPackName}" />
                    <TextBlock Text="{Binding AudioModeName}" FontSize="15" Foreground="#A8B6C0" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0" ToolTip="{Binding SimulatorLinkDetail}">
                    <TextBlock Text="SimConnect" Style="{StaticResource PanelLabel}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse Fill="{Binding SimulatorConnectionColor}" Width="8" Height="8" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding SimulatorConnectionStatus}" FontSize="16" Foreground="{Binding SimulatorConnectionColor}" />
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Button x:Name="ConnectSimulatorButton" Width="180" ContentTemplate="{StaticResource ActionLabel}" Content="{Binding L[C.Connection.Connect]}" Command="{Binding StartCommand}"
                            ToolTip="{Binding ConnectionActionHint}" ToolTipService.ShowOnDisabled="True">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SuccessButton}">
                            <Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                        </Style></Button.Style>
                    </Button>
                    <Button x:Name="DisconnectSimulatorButton" Width="180" ContentTemplate="{StaticResource ActionLabel}" Content="{Binding L[C.Connection.Disconnect]}" Command="{Binding StopCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolVisibility}}" />
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="ShellStatusBar" Grid.Row="3" Background="{StaticResource Cockpit.Panel}" BorderBrush="#43515D" BorderThickness="0,1,0,0" Padding="18,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Ellipse Fill="{Binding StatusColor}" Stroke="#05090C" StrokeThickness="2" Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="16" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" Margin="0,0,25,0" />
                </Grid>
                <ProgressBar Grid.Column="1" Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="100"
                             IsIndeterminate="{Binding IsIndeterminate}" Height="5" VerticalAlignment="Center"
                             Visibility="{Binding ShowProgress, Converter={StaticResource BoolVisibility}}" Margin="0,0,24,0" />
                <TextBlock Grid.Column="3" Text="{Binding Version, StringFormat=v{0}}" FontSize="13" Foreground="#9DACB6" VerticalAlignment="Center" />
                <Button Grid.Column="2" ContentTemplate="{StaticResource ActionLabel}" Content="{Binding L[Chrome.Cancel]}" Command="{Binding CancelH145Command}" Style="{StaticResource SecondaryButton}" Margin="0,0,16,0"
                        Visibility="{Binding IsUpdatingH145, Converter={StaticResource BoolVisibility}}" />
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
