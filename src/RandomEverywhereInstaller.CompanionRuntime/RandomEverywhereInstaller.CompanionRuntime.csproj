<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>CompanionRuntime</AssemblyName>
    <RootNamespace>HPGMissionCompanion</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>None</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <EmbeddedResource Include="VoicePacks/EN.xml" LogicalName="VoicePacks.EN.xml" />
    <EmbeddedResource Include="Profiles/Recommended.json" LogicalName="profile.Recommended.json" />
    <Content Include="Native/win-x64/SimConnect.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" TargetPath="SimConnect.dll" />
  </ItemGroup>
  <Target Name="RequireSimConnectRedistributable" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('Native/win-x64/SimConnect.dll')" Text="The approved, unmodified x64 SimConnect redistributable is required for distribution." />
  </Target>
</Project>
