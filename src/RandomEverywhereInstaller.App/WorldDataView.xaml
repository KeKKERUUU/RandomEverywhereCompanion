<UserControl x:Class="RandomEverywhereInstaller.App.WorldDataView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource Brush.Window}" Foreground="{StaticResource Brush.Text}">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="{Binding L[C.World.Hint]}" TextWrapping="Wrap" FontSize="14"/>
    <TextBlock Text="{Binding WorkFolderDisplay}" Foreground="{StaticResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkFolderDisplay}" FontSize="13" Margin="0,4,8,0"/>
   </StackPanel>
   <Button Grid.Column="1" Content="{Binding L[Action.Browse]}" Command="{Binding BrowseWorkCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
  </Grid>
  <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,10">
   <Button VerticalAlignment="Stretch" ContentTemplate="{StaticResource ActionLabel}" Content="{Binding L[C.World.Sync]}" Command="{Binding SyncWorldCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"/>
   <Button VerticalAlignment="Stretch" ContentTemplate="{StaticResource ActionLabel}" Content="{Binding L[C.World.Write]}" Command="{Binding WriteWorldCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
   <Button VerticalAlignment="Stretch" ContentTemplate="{StaticResource ActionLabel}" Content="{Binding L[C.World.Apply]}" Command="{Binding ApplyWorldCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
   <Button VerticalAlignment="Stretch" ContentTemplate="{StaticResource ActionLabel}" Content="{Binding L[C.World.Restore]}" Command="{Binding RestoreWorldCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
   <Button VerticalAlignment="Stretch" ContentTemplate="{StaticResource ActionLabel}" Content="{Binding L[C.World.Share]}" Command="{Binding ShareWorldCommand}" Style="{StaticResource SecondaryButton}"/>
  </UniformGrid>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="4*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,10,0"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid IsEnabled="{Binding CanEditAudio}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ComboBox ItemsSource="{Binding WorldKinds}" SelectedValue="{Binding WorldKindId}" SelectedValuePath="Id" AutomationProperties.Name="{Binding L[C.World.Type]}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
     <CheckBox Grid.Column="1" IsChecked="{Binding WorldRemoval}" IsEnabled="{Binding WorldCanRemove}" Content="{Binding L[C.World.RemovePoint]}" Margin="12,0,0,0" VerticalAlignment="Center"/>
    </Grid>
    <ItemsControl Grid.Row="1" ItemsSource="{Binding WorldFields}" IsEnabled="{Binding CanEditAudio}" Margin="0,8,0,0" VerticalAlignment="Top">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,8,6" MinHeight="54">
      <StackPanel Visibility="{Binding IsText, Converter={StaticResource BoolVisibility}}">
       <TextBlock Text="{Binding Label}" FontSize="14" Margin="0,0,0,3" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/>
       <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Padding="5,3" FontSize="14" Height="30" MaxLength="600" AutomationProperties.Name="{Binding Label}"/>
      </StackPanel>
      <CheckBox Visibility="{Binding IsFlag, Converter={StaticResource BoolVisibility}}" Content="{Binding Label}" IsChecked="{Binding Checked}" FontSize="13" Margin="0,7,0,0"/>
     </Grid></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <UniformGrid Grid.Row="2" Columns="2" Margin="0,8,0,0">
     <Button VerticalAlignment="Stretch" ContentTemplate="{StaticResource ActionLabel}" Content="{Binding L[C.World.New]}" Command="{Binding NewWorldCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
     <Button VerticalAlignment="Stretch" ContentTemplate="{StaticResource ActionLabel}" Content="{Binding L[C.World.Save]}" Command="{Binding SaveWorldCommand}" Style="{StaticResource SuccessButton}"/>
    </UniformGrid>
   </Grid></Border>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding L[C.World.MyList]}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <ListBox Grid.Row="1" ItemsSource="{Binding WorldEntries}" SelectedItem="{Binding WorldSelected}" Background="#0B1319" Foreground="#DCE7ED" BorderBrush="#43515D" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{Binding L[C.World.MyList]}"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="4" FontSize="14"/></DataTemplate></ListBox.ItemTemplate></ListBox>
    <UniformGrid Grid.Row="2" Columns="2" Margin="0,8,0,0">
     <Button VerticalAlignment="Stretch" ContentTemplate="{StaticResource ActionLabel}" Content="{Binding L[C.World.Edit]}" Command="{Binding EditWorldCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
     <Button VerticalAlignment="Stretch" ContentTemplate="{StaticResource ActionLabel}" Content="{Binding L[C.World.Remove]}" Command="{Binding RemoveWorldCommand}" Style="{StaticResource SecondaryButton}"/>
    </UniformGrid>
   </Grid>
  </Grid>
  <DockPanel Grid.Row="3" Margin="0,8,0,0">
   <Button DockPanel.Dock="Right" Content="{Binding L[Chrome.Cancel]}" Command="{Binding CancelWorldCommand}" Style="{StaticResource GhostButton}"/>
   <TextBlock Text="{Binding WorldReport}" TextTrimming="CharacterEllipsis" ToolTip="{Binding WorldReport}" FontSize="14" VerticalAlignment="Center"/>
  </DockPanel>
 </Grid>
</UserControl>
