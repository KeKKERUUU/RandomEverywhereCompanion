<UserControl x:Class="RandomEverywhereInstaller.App.OperationPrompt"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="{StaticResource Brush.Window}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Padding="20">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16"/>
   <TextBox x:Name="Message" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="{StaticResource Brush.Text}" BorderThickness="0" FontSize="16" Padding="0"/>
   <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
    <Button x:Name="CancelAction" IsDefault="True" IsCancel="True" Style="{StaticResource SecondaryButton}" MinWidth="120" Margin="0,0,10,0" Click="CancelClick"/>
    <Button x:Name="AcceptAction" IsDefault="False" Style="{StaticResource SuccessButton}" MinWidth="120" Click="AcceptClick"/>
   </StackPanel>
  </Grid>
 </Border>
</UserControl>
