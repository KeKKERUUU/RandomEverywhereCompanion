<UserControl x:Class="RandomEverywhereInstaller.App.InstallerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wizard="clr-namespace:RandomEverywhereInstaller.Core.Wizard;assembly=RandomEverywhereInstaller.Core">
 <UserControl.Resources>
  <Style x:Key="FilesPage" TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static wizard:WizardStep.ZipFolder}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="ReviewPage" TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static wizard:WizardStep.PackageCheck}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="InstallPage" TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static wizard:WizardStep.Installation}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="CompletedPage" TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static wizard:WizardStep.Completed}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
 </UserControl.Resources>
 <Grid Background="{StaticResource Brush.Window}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12">
   <TextBlock Text="{Binding CurrentTitle}" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding CommunityPath}" FontSize="14" Foreground="{StaticResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CommunityPath}" Margin="0,5,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1">
   <Grid Style="{StaticResource FilesPage}">
    <Grid.ColumnDefinitions>
     <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="*"/><Style.Triggers><DataTrigger Binding="{Binding IsAndrewUpdateOnly}" Value="True"><Setter Property="Width" Value="0"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
     <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="16"/><Style.Triggers><DataTrigger Binding="{Binding IsAndrewUpdateOnly}" Value="True"><Setter Property="Width" Value="0"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
     <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid>
     <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsAndrewUpdateOnly}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="{Binding CommunityPackageSummary}" Margin="0,0,0,8" FontSize="15"/>
     <ListBox Grid.Row="1" ItemsSource="{Binding CommunityPackages}" Background="{StaticResource Brush.Surface}" Foreground="{StaticResource Brush.Text}" BorderBrush="{StaticResource Brush.Border}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
      <ListBox.ItemTemplate><DataTemplate>
       <Grid Margin="6,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding StateText}" Foreground="{Binding StatusColor}" FontSize="14"/></StackPanel>
        <Button Grid.Column="1" Content="{Binding DataContext.DownloadLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding DataContext.OpenDownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="8,0,0,0">
         <Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowDownload}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
        </Button>
       </Grid>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
    <Border x:Name="FileDropArea" Grid.Column="2" BorderBrush="{StaticResource Brush.Accent}" BorderThickness="1" Background="{StaticResource Brush.Surface}" CornerRadius="3" Padding="14" AllowDrop="True" DragOver="FilesDragOver" Drop="FilesDrop">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding ZipFolderLabel}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Grid.Row="1" Text="{Binding ZipFolderHint}" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" FontSize="14" Margin="0,8,0,10"/>
      <Grid Grid.Row="2">
       <TextBlock Text="{Binding ZipFolderEmptyStatus}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16">
        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasArchiveInputs}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
       <ListBox ItemsSource="{Binding ZipArchives}" Background="{StaticResource Brush.Surface}" Foreground="{StaticResource Brush.Text}" BorderBrush="{StaticResource Brush.Border}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.Style><Style TargetType="ListBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasArchiveInputs}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ListBox.Style>
        <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding FileName}" FontSize="15" TextWrapping="Wrap"/><TextBlock Text="{Binding Directory}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Directory}" Foreground="{StaticResource Brush.TextMuted}" FontSize="13"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </Grid>
      <DockPanel Grid.Row="3" Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="{Binding BrowseLabel}" Click="BrowseFiles" Style="{StaticResource SecondaryButton}"/><TextBlock Text="{Binding ZipArchiveCount}" VerticalAlignment="Center" FontSize="14"/></DockPanel>
     </Grid>
    </Border>
   </Grid>
   <Grid Style="{StaticResource ReviewPage}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="{Binding ScanAgainLabel}" Command="{Binding ScanAgainCommand}" Style="{StaticResource SecondaryButton}"/><TextBlock Text="{Binding PackageSummary}" VerticalAlignment="Center" FontSize="16"/></DockPanel>
    <ListBox Grid.Row="1" ItemsSource="{Binding Packages}" Background="{StaticResource Brush.Surface}" Foreground="{StaticResource Brush.Text}" BorderBrush="{StaticResource Brush.Border}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,5"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding StateText}" Foreground="{Binding StatusColor}" FontSize="14"/><TextBlock Text="{Binding FileName}" FontSize="14" TextWrapping="Wrap"/><TextBlock Text="{Binding ErrorDetail}" Foreground="{Binding StatusColor}" FontSize="14" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Grid>
   <Grid Style="{StaticResource InstallPage}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="{Binding ReadyBanner}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding ReviewVersions}" FontSize="14" Margin="0,5,0,8" TextWrapping="Wrap"/></StackPanel>
    <ListBox Grid.Row="1" ItemsSource="{Binding ReviewItems}" Background="{StaticResource Brush.Surface}" Foreground="{StaticResource Brush.Text}" BorderBrush="{StaticResource Brush.Border}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,5"><TextBlock Text="{Binding Package}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Effect}" FontSize="14" TextWrapping="Wrap"/><TextBlock Text="{Binding Destination}" FontSize="14" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Grid.Row="2" Text="{Binding ReviewSafety}" TextWrapping="Wrap" FontSize="14" Margin="0,10" Foreground="{StaticResource Brush.TextMuted}"/>
    <Button Grid.Row="3" Content="{Binding InstallLabel}" Command="{Binding StartInstallationCommand}" Style="{StaticResource SuccessButton}" HorizontalAlignment="Right" MinWidth="160"/>
   </Grid>
   <Grid Style="{StaticResource CompletedPage}"><TextBlock Text="{Binding CompletedSummary}" Foreground="{StaticResource Brush.Success}" FontSize="20" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="720"/></Grid>
  </Grid>
  <Grid Grid.Row="2" Margin="0,12,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="ReturnButton" Content="{Binding ReturnToMissionLabel}" Command="{Binding ExitCommand}" HorizontalAlignment="Left">
    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static wizard:WizardStep.Completed}"><Setter Property="Background" Value="{StaticResource Brush.Success}"/></DataTrigger></Style.Triggers></Style></Button.Style>
   </Button>
   <Button x:Name="PreviousButton" Grid.Column="1" Content="{Binding BackLabel}" Command="{Binding BackCommand}" Margin="0,0,8,0">
    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static wizard:WizardStep.ZipFolder}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static wizard:WizardStep.Completed}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
   </Button>
   <Button x:Name="ContinueButton" Grid.Column="2" Content="{Binding NextLabel}" Command="{Binding NextCommand}" MinWidth="120">
    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SuccessButton}"><Style.Triggers>
     <DataTrigger Binding="{Binding IsExitAction}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
     <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static wizard:WizardStep.Installation}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
     <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static wizard:WizardStep.Completed}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
    </Style.Triggers></Style></Button.Style>
   </Button>
  </Grid>
  <Border Grid.Row="3" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusMessageColor}" FontSize="15" TextWrapping="Wrap"/><TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource Brush.TextMuted}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusDetail}"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="{Binding ProgressValue, StringFormat={}{0:0}%}"/><ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Minimum="0" Maximum="100" Height="6" Margin="0,6,0,0"/></StackPanel>
    <Button Grid.Column="2" Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}"/>
   </Grid>
  </Border>
 </Grid>
</UserControl>
